      "type": "string",
      "description": "Name of independent auditor or auditing firm",
      "required": true
    },
    {
      "name": "project_title",
      "type": "string",
      "description": "Audited project title",
      "required": true
    },
    {
      "name": "financial_year",
      "type": "string",
      "description": "Financial year audited",
      "required": true
    },
    {
      "name": "audit_opinion",
      "type": "string",
      "description": "Auditor's opinion (Unqualified, Qualified, Adverse, Disclaimer)",
      "required": true
    },
    {
      "name": "audit_date",
      "type": "date",
      "description": "Date of audit completion",
      "required": true
    }
  ]
