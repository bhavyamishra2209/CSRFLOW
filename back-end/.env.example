# Firebase Configuration (REQUIRED for cloud storage and persistence)
# Get these values from Firebase Console after setup

# Path to your Firebase service account key JSON file
# Download from: Firebase Console → Project Settings → Service Accounts → Generate Key
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Your Firebase Storage bucket name
# Format: your-project-id.appspot.com
# Find in: Firebase Console → Project Settings → General → Storage bucket
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ==========================================
# Supabase Authentication (REQUIRED for user auth - Phase 2)
# ==========================================
# Get these from: https://app.supabase.com → Project Settings → API
#
# Your Supabase project URL (e.g. https://xyzabcdef.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
#
# Service role key — KEEP SECRET, never expose to clients
# Find under: Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
#
# JWT secret — used to verify tokens locally without a network round-trip
# Find under: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here
#
# Comma-separated list of Supabase user UUIDs that are admin users
# e.g. ADMIN_USER_IDS=uuid1,uuid2
ADMIN_USER_IDS=

# ==========================================
# CORS (Phase 10 — Deployment)
# ==========================================
# Comma-separated list of allowed frontend origins.
# Example: https://myapp.vercel.app,https://myapp.expo.dev
# For local development: http://localhost:3000,http://localhost:8081
# NEVER use * with allow_credentials=True — it is both insecure and invalid.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ==========================================
# Neo4j Knowledge Graph (Phase 3)
# ==========================================
# Free forever tier: https://neo4j.com/cloud/platform/aura-graph-database/
# After creating a free AuraDB instance, copy the connection URI shown on the
# dashboard.  It looks like: neo4j+s://xxxxxxxx.databases.neo4j.io
#
# Set NEO4J_ENABLED=true to activate graph DB persistence.
# If false (default) the in-memory KG still works — Neo4j is enhancement only.
#
NEO4J_ENABLED=false
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password-here
NEO4J_DATABASE=neo4j
# 1. Go to: https://console.firebase.google.com/
# 2. Create a new project
# 3. Enable Firestore Database
# 4. Enable Cloud Storage
# 5. Download service account key
# 6. Copy this file to .env and fill in your values
# 
# See FIREBASE_SETUP_GUIDE.md for detailed instructions
