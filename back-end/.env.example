# ==========================================
# Firebase Configuration
# ==========================================
# Download from: Firebase Console → Project Settings → Service Accounts → Generate Key
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ==========================================
# Supabase Authentication
# ==========================================
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Comma-separated list of Supabase user UUIDs that are admin users
ADMIN_USER_IDS=your-admin-user-uuid-here

# ==========================================
# Neo4j Knowledge Graph (optional)
# ==========================================
NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# ==========================================
# HuggingFace API (optional, for hosted LLM fallback)
# ==========================================
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:19006

# ==========================================
# Dev / Testing bypass
# ==========================================
# Set to true to skip JWT auth for local testing.
# NEVER set to true in production.
SKIP_AUTH=false
